FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
      git python3 python3-pip && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements/world.txt /tmp/world.txt
RUN python3 -m pip install -r /tmp/world.txt
COPY pyproject.toml README.md ./
COPY src ./src
COPY configs ./configs
RUN python3 -m pip install --no-deps . && python3 -m pip install \
      "fastapi>=0.115,<1" "httpx>=0.27,<1" "pydantic>=2.9,<3" \
      "pyyaml>=6,<7" "uvicorn[standard]>=0.30,<1"

ENV AIRGPT_MODEL_CONFIG=/app/configs/models.yaml \
    AIRGPT_ARTIFACT_DIR=/app/artifacts/runtime-world \
    HF_HOME=/app/.cache/huggingface-world

EXPOSE 8001
HEALTHCHECK --interval=20s --timeout=5s --start-period=90s --retries=5 \
  CMD python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8001/health/live', timeout=3)" || exit 1
CMD ["airgpt", "serve", "--model", "ltx_video", "--host", "0.0.0.0", "--port", "8001"]
