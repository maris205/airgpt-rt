FROM nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
      git python3 python3-pip && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements/octo.txt /tmp/octo.txt
RUN python3 -m pip install -r /tmp/octo.txt && \
    python3 -m pip install "jax[cuda11_pip]==0.4.20" \
      -f https://storage.googleapis.com/jax-releases/jax_cuda_releases.html
COPY pyproject.toml README.md ./
COPY src ./src
COPY configs ./configs
RUN python3 -m pip install .

ENV AIRGPT_MODEL_CONFIG=/app/configs/models.yaml \
    AIRGPT_ARTIFACT_DIR=/app/artifacts/runtime-octo \
    HF_HOME=/app/.cache/huggingface-octo \
    TRANSFORMERS_OFFLINE=1 \
    XLA_PYTHON_CLIENT_PREALLOCATE=false \
    TF_CPP_MIN_LOG_LEVEL=2

EXPOSE 8003
HEALTHCHECK --interval=20s --timeout=5s --start-period=90s --retries=5 \
  CMD python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8003/health/live', timeout=3)" || exit 1
CMD ["airgpt", "serve", "--model", "octo", "--host", "0.0.0.0", "--port", "8003"]
